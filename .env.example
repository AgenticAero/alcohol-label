# Copy to `.env` (ignored by Git). Never commit real credentials, API keys or
# private endpoints to this file.

# Required by the AL-8 extraction adapter and AL-6 spike. Keep secrets server-side.
OPENAI_API_KEY=
# Kept configurable so the model can change based on measured results.
OPENAI_MODEL=gpt-6-luna
# Optional; defaults to https://api.openai.com/v1
OPENAI_BASE_URL=
# Optional reasoning effort; AL-6 found low usable, while minimal was rejected.
OPENAI_REASONING_EFFORT=low
