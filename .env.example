# Copy to `.env` (ignored by Git). Never commit real credentials, API keys or
# private endpoints to this file.

# Used only by scripts/al6_extraction_spike.py until the AL-8 adapter exists.
OPENAI_API_KEY=
# Kept configurable so the model can change based on measured results.
OPENAI_MODEL=gpt-6-luna
# Optional; defaults to https://api.openai.com/v1
OPENAI_BASE_URL=
# Optional reasoning effort (for example low); empty uses the model default.
OPENAI_REASONING_EFFORT=
